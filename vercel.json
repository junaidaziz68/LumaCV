{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd FrontEnd && npm install && npm run build",
  "outputDirectory": "FrontEnd/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 30
    }
  }
}
